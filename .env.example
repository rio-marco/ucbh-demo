# Claude Platform OAuth (Linked billing)
# Required for the user click-to-login flow.
CLAUDE_CLIENT_ID=
CLAUDE_USER_PROFILE_ID=uprof_...
CLAUDE_OAUTH_REDIRECT_URI=http://localhost:3000/api/claude/callback
CLAUDE_CLIENT_ASSERTION_ISSUER=
CLAUDE_CLIENT_ASSERTION_AUDIENCE=
CLAUDE_CLIENT_ASSERTION_SUBJECT=
CLAUDE_CLIENT_ASSERTION_KID=
CLAUDE_CLIENT_ASSERTION_PRIVATE_KEY=

# Optional OAuth endpoints and scopes.
# Scopes must match the Claude OAuth app's allowed scopes. Add offline_access
# only if the app has Offline access enabled.
CLAUDE_AUTHORIZE_URL=https://auth.claude.com/oauth/authorize
CLAUDE_PAR_URL=https://auth.claude.com/v1/oauth/par
CLAUDE_TOKEN_URL=https://auth.claude.com/v1/oauth/token
CLAUDE_REVOKE_URL=https://auth.claude.com/v1/oauth/revoke
CLAUDE_OAUTH_SCOPES=billing:attribution

# Claude model settings. OAuth env files are read at runtime.
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_FALLBACK_MODELS=claude-haiku-4-5-20251001

CLAUDE_BILLING_FALLBACK=false

QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback
QB_ENVIRONMENT=sandbox
QB_ALLOW_PRODUCTION_WRITES=false

# MCP Connector persistence uses a local JSON file at .data/mcp-store.json
# No database service or configuration is required.

# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Any random string of at least 32 characters
MCP_SIGNING_SECRET=

# Optional. Defaults to <current origin>/api/mcp
MCP_SERVER_URL=

# Enables confirmed QuickBooks writes from the MCP Connector
MCP_ALLOW_WRITES=false
