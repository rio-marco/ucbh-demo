# Claude / QuickBooks (existing workspace flow)
CLAUDE_API_KEY=
CLAUDE_AUTH_TOKEN=
CLAUDE_MODEL=
CLAUDE_FALLBACK_MODELS=

# Per-browser Claude sign-in used before the MCP connection.
# Without these, the workspace uses a guided demo sign-in flow.
CLAUDE_CLIENT_ID=
CLAUDE_CLIENT_SECRET=
CLAUDE_OAUTH_REDIRECT_URI=http://localhost:3000/api/claude/callback
CLAUDE_OAUTH_AUTHORIZE_URL=https://claude.ai/oauth/authorize
CLAUDE_OAUTH_TOKEN_URL=https://console.anthropic.com/v1/oauth/token
CLAUDE_OAUTH_SCOPES=org:read
CLAUDE_LOGIN_URL=https://claude.ai/login

QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback
QB_ENVIRONMENT=sandbox
QB_ALLOW_PRODUCTION_WRITES=false

# MCP Connector persistence uses a local JSON file at .data/mcp-store.json
# No database service or configuration is required.

# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Any random string of at least 32 characters
MCP_SIGNING_SECRET=

# Optional. Defaults to <current origin>/api/mcp
MCP_SERVER_URL=

# Enables confirmed QuickBooks writes from the MCP Connector
MCP_ALLOW_WRITES=false
